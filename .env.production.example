# ---------------------------------------------------------------------------
# Kaluta Society — production environment
#
# Copy to .env ON THE SERVER and fill in. Never commit it, never reuse the
# development values: the dev .env ships a known JWT secret and a known database
# password, and anything using them is unauthenticated in practice.
#
# Generate each secret separately:
#     openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=kaluta
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=kaluta
# Must match POSTGRES_USER/PASSWORD above. The host is the compose service name,
# not localhost — the services reach it over the private network.
DATABASE_URL=postgresql://kaluta:CHANGE_ME@postgres:5432/kaluta

# --- Redis / RabbitMQ -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=kaluta
RABBITMQ_PASSWORD=            # openssl rand -hex 24
RABBITMQ_URL=amqp://kaluta:CHANGE_ME@rabbitmq:5672/

# --- Security -------------------------------------------------------------
# Rotating this signs every existing session out. That is the intended
# behaviour if it ever leaks.
JWT_SECRET=                   # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Encryption at rest for members' messages and chat attachments.
#
#   REQUIRED in production: messaging-service and media-service refuse to start
#   without it, rather than quietly storing messages in plaintext.
#
#   Generate once (bootstrap.sh does it for you if this is left empty):
#     python3 -c "import base64,secrets;print('k1:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
#   !! LOSING THIS KEY LOSES EVERY MESSAGE AND ATTACHMENT IT SEALED, FOREVER. !!
#   Keep a copy in a password manager — NOT on this server, NOT next to the
#   database backups (a backup stored with its key is a backup in plaintext).
#
#   Rotation: put a new key first and keep the old one after it,
#     MESSAGES_ENCRYPTION_KEY=k2:<new>,k1:<old>
#   New data uses k2; on restart everything sealed with k1 is re-sealed with
#   k2 in the background. Remove k1 only once the logs report it done.
#
#   It protects a stolen database copy or backup. It does not protect against
#   someone who controls the running server, which holds the key.
MESSAGES_ENCRYPTION_KEY=

# Passkeys are bound to an exact origin. WEBAUTHN_RP_ID is the bare domain (no
# scheme, no port) and WEBAUTHN_ORIGIN must be the https:// URL people actually
# visit — a mismatch makes every ceremony fail with an opaque browser error.
# Passkeys do not work over plain http off localhost at all.
WEBAUTHN_RP_ID=kinjy.com
WEBAUTHN_RP_NAME=Kinjy
WEBAUTHN_ORIGIN=https://kinjy.com

# --- Public URLs ----------------------------------------------------------
# One origin: nginx serves the app and proxies /api to the gateway, so these are
# the same host. FRONTEND_URL is what CORS allows; get it wrong and the browser
# blocks its own API.
FRONTEND_URL=https://kinjy.com
GATEWAY_URL=https://kinjy.com

# Unused while Caddy fronts the stack — it reaches the web container over the
# private network and nothing but 80/443 is published. Kept for the fallback
# case: if another server already owns 80/443 on this machine, drop the caddy
# service from docker-compose.prod.yml, give `web` this host port back, and
# point the existing server at it.


# Uploaded media, served from the same origin. Relative on purpose: an absolute
# URL bakes the hostname into every stored asset row, and the development
# default (http://localhost:8200/media) pointed every image at the visitor's own
# machine once deployed.
MEDIA_PUBLIC_BASE=/media

# Avatars and covers are stored on UploadCenter; post media stays on the local
# volume above. Use a production key, distinct from the development one.
UPLOADCENTER_API_BASE=https://api.uploadscenter.com
UPLOADCENTER_API_KEY=
UPLOADCENTER_PROJECT_ID=

# --- Money model (blueprint-authoritative) --------------------------------
MARKETPLACE_MARKUP_PCT=20
AD_AFFILIATE_POOL_PCT=10
AD_AFFILIATE_L1_PCT=5
CREATOR_SHARE_PCT=40
CREATOR_INVITER_L1_PCT=5

# --- Payment rails --------------------------------------------------------
# Left empty, both providers stay in mock mode: the ledger and the splits are
# real, money movement is not. Filling these in is what makes payouts leave the
# building, so do it deliberately.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
MANGOPAY_CLIENT_ID=
MANGOPAY_API_KEY=
