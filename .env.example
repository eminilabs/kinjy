# ---------------------------------------------------------------------------
# Kaluta Society — environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Postgres (single instance, one schema per service) ---
POSTGRES_USER=kaluta
POSTGRES_PASSWORD=kaluta_dev_password
POSTGRES_DB=kaluta
POSTGRES_PORT=5445
DATABASE_URL=postgresql://kaluta:kaluta_dev_password@postgres:5432/kaluta

# --- Redis / RabbitMQ ---
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Security ---
# openssl rand -hex 32
JWT_SECRET=change_me_dev_only_0000000000000000000000000000000000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
# WebAuthn / passkeys (device-level, no central biometric store)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kaluta Society
WEBAUTHN_ORIGIN=http://localhost:3030

# --- Public URLs ---
FRONTEND_URL=http://localhost:3030
GATEWAY_URL=http://localhost:8200

# --- Money model (blueprint-authoritative, see docs/economy.md) ---
# Marketplace: vendor price + MARKETPLACE_MARKUP_PCT markup = customer price.
MARKETPLACE_MARKUP_PCT=20
# Ad affiliate pool: 10% total -> L1 5%, L2..L10 share 5%
AD_AFFILIATE_POOL_PCT=10
AD_AFFILIATE_L1_PCT=5
# Creator ad revenue share
CREATOR_SHARE_PCT=40
CREATOR_INVITER_L1_PCT=5
CREATOR_INVITER_LN_PCT=1
# Service affiliate
SERVICE_L1_PCT=20
SERVICE_LN_PCT=1
LEADERS_POOL_PCT=5
LEADERS_POOL_SIZE=10000
# Payout threshold (USD) before a member enters a payout batch
PAYOUT_THRESHOLD_USD=1.00
KYC_ANNUAL_FEE_USD=10.00

# --- Payment rails (leave blank in dev: services run in mock mode) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAYOUT_CURRENCY=usdtbsc
MANGOPAY_CLIENT_ID=
MANGOPAY_API_KEY=
MANGOPAY_BASE_URL=https://api.sandbox.mangopay.com

# --- AI gateway (provider-independent; no provider => deterministic mock router) ---
# Provider KEYS do not go in this file: it is handed to every container. Copy
# .env.ai.example to .env.ai (git-ignored, read by ai-service only) and put them there.
AI_DEFAULT_PROVIDER=mock
# Off means off: even with a key and an adapter, nothing is sent to a provider
# until this is true. Also the switch to stop spending in a hurry.
AI_LIVE_ENABLED=false
# AI credits (they do not apply to the stand-in or to a cached answer). A credit is AI_CREDIT_CHARS characters of a
# member's writing sent to the provider; a plan has that many credits a calendar month. Defaults: 1000, and 20 / 200
# / 1000 for Free / Basic / Premium (worst case at the measured price: 0.07 / 0.70 / 3.50 USD per member a month).
# AI_CREDIT_CHARS=1000
# AI_CREDITS_FREE=20
# AI_CREDITS_BASIC=200
# AI_CREDITS_PREMIUM=1000
# Whether a recorded plan is believed. KEEP IT FALSE until billing confirms subscriptions: POST /subscriptions
# only records a plan, so today anyone can record themselves as Premium for nothing.
# AI_CREDITS_TRUST_SUBSCRIPTIONS=false
# The platform's own ceiling, in USD a month, from the cost each real call was recorded with. When it is spent
# translation pauses for everybody. Default 5.
# AI_MONTHLY_BUDGET_USD=5

# Newsletters need mail (see SMTP_* above). At most this many people per issue and this many issues per creator
# per 24 hours; a pause between mails; and, where the law of a recipient's country asks for it in a commercial
# e-mail, the sender's postal address, printed in every footer.
# NEWSLETTER_MAX_RECIPIENTS=1000
# NEWSLETTER_MAX_ISSUES_PER_DAY=2
# NEWSLETTER_SEND_INTERVAL_SECONDS=0.2
# NEWSLETTER_POSTAL_ADDRESS=

# --- Media storage ---
MEDIA_ROOT=/data/media
MEDIA_PUBLIC_BASE=http://localhost:8200/media

# --- UploadCenter (avatars / covers) — server-side only, never VITE_* ---
UPLOADCENTER_API_BASE=https://api.uploadscenter.com
UPLOADCENTER_API_KEY=
UPLOADCENTER_PROJECT_ID=
# Where new post media is stored: local | uploadcenter. Keep local until the UploadCenter
# plan covers the volume (see the quota); existing files are not moved.
POST_MEDIA_PROVIDER=local

# Encryption at rest for messages and chat attachments. Optional in
# development (messages are stored in the clear without it), required in
# production. Generate:
#   python3 -c "import base64,secrets;print('k1:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Losing the key makes everything it sealed unreadable. See backend/common/crypto.py.
MESSAGES_ENCRYPTION_KEY=
