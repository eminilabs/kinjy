# AI provider keys.
#
#   cp .env.ai.example .env.ai      then put the real values in .env.ai
#
# .env.ai is git-ignored and is read by ai-service ONLY (docker-compose.yml). .env is
# handed to all 13 containers, so a key kept there is a key every service can read:
# it would still work, because ai-service reads both files, but keep it here.
# In production, set these in the server's environment instead of a file.
#
# A key alone does nothing. A provider is used only when its key is set, an adapter
# for it exists in backend/ai-service, AND AI_LIVE_ENABLED=true (that switch lives in
# .env, and stays false until you mean it).

# --- IleAI: the chosen provider (translation) -----------------------------------
# https://docs.ileai.io - a router in front of several model vendors. The key is sent in
# the X-API-Key header (the prose docs say "Authorization: Bearer", which is wrong).
# emk_test_... is for development, emk_live_... is billed. Create the key with only the
# scope it needs ("translation").
ILEAI_API_KEY=

# Pin the translation model so the router can never send the text to another vendor.
# Empty = the router chooses; the adapter then throws away any answer from a provider
# not in ILEAI_ALLOWED_PROVIDERS (an alarm after the fact, not a control).
# The names you can put here: GET https://api.ileai.io/v1/models?category=translation
# (header X-API-Key). On 2026-10-12 the only one was: deepl-translate-v2
ILEAI_TRANSLATE_MODEL=
ILEAI_ALLOWED_PROVIDERS=deepl

# Which engine translates. The default, "translate", is IleAI's translation endpoint (DeepL).
#   chat  = a language model through /v1/chat/completions - for when DeepL is down, or for a
#           language it does not do. The text then goes to that model's vendor (OpenAI for
#           gpt-5-mini): your decision, made here, never the code's.
#   auto  = "translate" first, "chat" only if the translation provider is unavailable (never
#           for "no credit" or "bad key").
ILEAI_TRANSLATE_ENGINE=translate
# Required for "chat" and "auto". The model is pinned (manual routing: that model, nowhere else).
# Names: GET https://api.ileai.io/v1/public/models?category=text   (checked 12/10: gpt-5-mini works)
ILEAI_CHAT_MODEL=
# An answer from any other vendor is thrown away, and logged.
ILEAI_CHAT_ALLOWED_PROVIDERS=openai
# Seconds a chat translation may take, all batches together (a model is slow: ~13 s per 1,700 characters).
# ILEAI_CHAT_TIMEOUT_SECONDS=55
# What IleAI bills, used to record each call's cost. Built in for the models on IleAI's public price
# list (12/10); set these only for a model that is not on it, or if the prices change.
# ILEAI_CHAT_PRICE_IN_PER_1K=0.001
# ILEAI_CHAT_PRICE_OUT_PER_1K=0.004
# ILEAI_TRANSLATE_PRICE_PER_1K_CHARS=0.00002

# Rarely needed. Plain http is accepted only outside production (for a local stand-in).
# ILEAI_BASE_URL=https://api.ileai.io
# ILEAI_TIMEOUT_SECONDS=18

# --- Other vendors the gateway can describe ------------------------------------
# None has an adapter yet, so a key set here is ignored (with a warning in
# ai-service's log, never printing the key) rather than answered with invented text.
KIMI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
