.env
# AI provider keys: read by ai-service only (see docker-compose.yml). Never committed.
.env.ai
# ...and any slip of the finger on its name (.env.ai. , .env.ai~ , .env.ai.bak): the template is the only one tracked.
.env.ai.*
.env.ai~
!.env.ai.example
# Any hand-made copy of it too: a file called .env.backup-2026-10-03 is
# not matched by the line above, and `git add -A` would publish every
# secret in it to a public repository.
.env.backup*
.env.*.backup
*.log
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
.DS_Store
.idea/
.vscode/

# Filled production secrets — never committed.
.env.production
.env.prodtest

# Server-side artefacts, never from a workstation.
backups/

# Local docs
serveur.md

# pytest scratch space, created by backend/tests/run_all.py
backend/.pytest-tmp/
